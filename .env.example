# ─── Next.js ───────────────────────────────────────────────
NODE_ENV=development

# ─── Robinhood Chain (EVM L2) ───────────────────────────────
ROBINHOOD_RPC_URL=https://your-robinhood-l2-rpc.example
ROBINHOOD_CHAIN_ID=46630

# ─── $BLACKBALLS token ─────────────────────────────────────
BLACKBALLS_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
BLACKBALLS_DECIMALS=18

# ─── CrashVault (deployed) ─────────────────────────────────
CRASH_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Backend hot wallet — NEVER expose to client bundle
BACKEND_SIGNER_PRIVATE_KEY=0xYOUR_BACKEND_SIGNER_PRIVATE_KEY

# Deployer (Foundry / viem deploy script only)
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
HOUSE_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
BACKEND_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
BURN_VIA_NATIVE=false

# ─── Optional ───────────────────────────────────────────────
ROBINHOOD_EXPLORER_API_KEY=

# ─── Client (wagmi / vault UI) ─────────────────────────────
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://your-robinhood-l2-rpc.example
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=46630
NEXT_PUBLIC_BLACKBALLS_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BLACKBALLS_DECIMALS=18
NEXT_PUBLIC_CRASH_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Supabase (referrals + clans) ──────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
